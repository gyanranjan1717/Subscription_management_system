PORT=5000
NODE_ENV=development
# Required in production (min 16 chars). A development-only fallback is used otherwise.
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/brightloop.sqlite
# Dev convenience: return the password-reset link in the API response. Always off in production.
EXPOSE_RESET_LINK=true
# Comma separated allowed origins; empty = reflect request origin (development).
CORS_ORIGIN=
