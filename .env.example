# Copy to backend/.env and fill in. Nothing here has a working default; the app refuses to
# start in production without JWT_SECRET, and features turn off cleanly when their keys are absent.

PORT=5000
NODE_ENV=development

# Public address of the web app. Used in emailed links (password reset, invoice, reminders).
APP_URL=http://localhost:3000
CORS_ORIGIN=

# Required in production: 16+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Lets someone create an ADMIN account from the sign-up page by entering this key. Leave empty to
# disable admin self-registration entirely (admins can then only be created by seeding).
# Must be 16+ characters when set.
ADMIN_REGISTRATION_KEY=

DATABASE_PATH=./data/brightloop.sqlite

# Local demo only: return OTP codes / reset links in API responses when no SMTP server is configured.
# Ignored (always off) in production.
EXPOSE_DEV_CODES=true
EXPOSE_RESET_LINK=true

# ------------------------------------------------------------------------------
# Email (SMTP). Without these, emails are only recorded in the outbox table and
# marked "simulated". For Gmail use an App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your normal password.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ------------------------------------------------------------------------------
# Razorpay (Dashboard > Account & Settings > API keys). rzp_test_* keys run in test
# mode: no real money moves. Without these, "Pay online" is hidden.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Dashboard > Webhooks > add https://YOUR-HOST/api/payments/razorpay/webhook,
# event payment.captured, and put the secret you chose here. It settles payments if the browser tab closes.
RAZORPAY_WEBHOOK_SECRET=
